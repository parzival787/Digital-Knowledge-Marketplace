# Google Cloud OAuth client: Web application. Register this exact callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Base64-encoded random 32-byte key for encrypted uploads. Back up separately
# from the database. Losing this key makes protected files unrecoverable.
CONTENT_MASTER_KEY=

# Current free RPC plan limits eth_getLogs to 10 blocks per query.
RPC_LOG_PAGE_SIZE=10
